# 运行环境：development / test / production
NODE_ENV=development

# HTTP 监听。容器平台通常会覆盖 PORT。
HOST=0.0.0.0
PORT=3000

# 当前部署的平台。一个部署环境只服务一个平台，避免身份和数据混用。
PLATFORM=wechat
APP_ID=replace-with-platform-app-id

# 仅在云端 Secret/环境变量中配置，禁止提交真实值。
APP_SECRET=replace-with-platform-app-secret

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# development/test 可用 memory；production 强制使用 mongo。
PERSISTENCE_DRIVER=memory

# 腾讯 CloudBase 文档型数据库的 MongoDB 外部连接配置。
# 连接串含凭据，只能存于本地 .env 或云端 Secret，禁止提交真实值。
CLOUD_DATABASE_URI=mongodb://replace-with-cloudbase-connection
CLOUD_DATABASE_NAME=miao_travel
